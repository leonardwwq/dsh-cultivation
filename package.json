{
  "name": "dsh-cultivation",
  "version": "0.4.1",
  "description": "角色养成：为 Agent 赋予可养成的 AI 角色（角色扮演 + 情感陪伴）——会话级角色绑定、亲密度随对话成长、分区记忆 + 追加日志自动归档、AI 设计助手。",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "plugin",
    "roleplay",
    "persona",
    "companion",
    "character",
    "角色养成",
    "角色扮演",
    "AI 陪伴"
  ],
  "scripts": {
    "check": "node scripts/check.cjs",
    "test": "node --test",
    "prepublishOnly": "npm run check"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./core": {
      "default": "./lib/core.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT",
  "author": "leonardwwq",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leonardwwq/dsh-cultivation.git"
  },
  "homepage": "https://github.com/leonardwwq/dsh-cultivation#readme",
  "bugs": {
    "url": "https://github.com/leonardwwq/dsh-cultivation/issues"
  }
}
